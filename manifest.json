{
  "manifest_version": 3,
  "name": "Personalized New Tab",
  "description": "A fully customizable new tab: live security and AI/robotics research feeds, world clock, to-do list, and daily quotes.",
  "version": "2.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "options_page": "options/index.html",
  "action": {
    "default_title": "Personalized New Tab",
    "default_popup": "popup/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16x16.png",
    "32": "icon32x32.png"
  }
}
